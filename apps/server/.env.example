# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── Auth ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/orbat
BETTER_AUTH_SECRET=change-me-min-16-chars
BETTER_AUTH_URL=http://localhost:3000

# ── Storage ───────────────────────────────────────────────────────────────────
# Options: local | cloudinary | vercel
STORAGE_PROVIDER=local
UPLOAD_FOLDER_PREFIX=military_orbat

# Cloudinary (required when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vercel Blob (required when STORAGE_PROVIDER=vercel)
BLOB_READ_WRITE_TOKEN=

# ── AI providers (set whichever you want selectable; no fallbacks) ─────────────
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=

# ── LangSmith tracing (optional) ──────────────────────────────────────────────
LANGCHAIN_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=military-orbat
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
